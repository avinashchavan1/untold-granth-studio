   "LF01"
  ]
 },
 "dasharatha": {
  "voice_sample": "untold-ramayana/cast/voice_dasharatha.mp3",
  "voice_line": {
   "reel": "A62",
   "shot": 5,
   "hi": "देवी, तब तुम्हारा विवाह भी नहीं हुआ था, और मैं युवराज था। वर्षा ऋतु थी।",
   "en": "\"My queen, you were not even married then, and I was the crown prince. It was the rainy season.\""
  },
  "appears_in": [
   "A62",
   "A82"
  ]
 },
 "vali": {
  "voice_sample": "untold-ramayana/cast/voice_vali.mp3",
  "voice_line": {
   "reel": "A103",
   "shot": 10,
   "hi": "मैं बार-बार पुकारता रहा, सुग्रीव! सुग्रीव! कोई उत्तर नहीं आया। लातें मार-मारकर, मैंने वो चट्टान तोड़ी।",
   "en": "\"I called again and again, 'Sugriva! Sugriva!' No answer came. I kicked that rock until it broke.\""
  },
  "appears_in": [
   "A103",
   "A104",
   "A35",
   "A36",
   "LF01"
  ]
 },
 "sugriva": {
  "voice_sample": "untold-ramayana/cast/voice_sugriva.mp3",
  "voice_line": {
   "reel": "A34",
   "shot": 3,
   "hi": "प्रभु, आज ही, उस बाली को मारिए, जो भाई के वेश में, मेरा शत्रु है।",
   "en": "\"My lord, today itself, kill Vali, my enemy in the form of a brother.\""
  },
  "appears_in": [
   "A34",
   "LF01"
  ]
 },
 "tara": {
  "voice_sample": "untold-ramayana/cast/voice_tara.mp3",
  "voice_line": {
   "reel": "A36",
   "shot": 5,
   "hi": "जो भाई, हारकर भागा था, वो इतनी जल्दी, फिर गरज रहा है। वो अकेला नहीं आया है।",
   "en": "\"The brother who fled in defeat is roaring again so soon. He has not come alone.\""
  },
  "appears_in": [
   "A36",
   "LF01"
  ]
 },
 "angada": {
  "voice_sample": "untold-ramayana/cast/voice_angada.mp3",
  "voice_line": {
   "reel": "LF01",
   "shot": 87,
   "hi": "पिताजी... मैं अंगद हूँ।",
   "en": "\"Father... I am Angada.\""
  },
  "appears_in": [
   "LF01"
  ]
 },
 "muniputra": {
  "voice_sample": "untold-ramayana/cast/voice_muniputra.mp3",
  "voice_line": {
   "reel": "A62",
   "shot": 7,
   "hi": "हाय! मुझ जैसे तपस्वी पर, शस्त्र कैसे गिरा?",
   "en": "\"Ah! How could a weapon fall on an ascetic like me?\""
  },
  "appears_in": [
   "A62"
  ]
 },
 "andhamuni": {
  "voice_sample": "untold-ramayana/cast/voice_andhamuni.mp3",
  "voice_line": {
   "reel": "A105",
   "shot": 6,
   "hi": "बेटा, इतनी देर क्यों? पानी जल्दी लाओ। तुम ही तो, हम अंधों की आँखें हो।",
   "en": "\"Son, why so late? Bring the water quickly. You are the eyes of us blind ones.\""
  },
  "appears_in": [
   "A105"
  ]
 }
