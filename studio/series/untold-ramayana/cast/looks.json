 "narrator": {
  "voice_sample": "untold-ramayana/cast/voice_narrator.mp3",
  "voice_line": {
   "reel": "A103",
   "shot": 1,
   "hi": "सुग्रीव, एक गुफ़ा के मुहाने पर, पूरे एक साल बैठे रहे। फिर, उन्होंने वो गुफ़ा, एक चट्टान से बंद कर दी।",
   "en": "Sugriva sat at the mouth of a cave for a whole year. Then he sealed it with a rock."
  },
  "appears_in": [
   "A01",
   "A02",
   "A03",
   "A04",
   "A06",
   "A07",
