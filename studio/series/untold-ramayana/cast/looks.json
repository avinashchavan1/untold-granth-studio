 "vali": {
  "voice_sample": "untold-ramayana/cast/voice_vali.mp3",
  "voice_line": {
   "reel": "A35",
   "shot": 3,
   "hi": "अगर सामने आकर लड़ते, तो आज, यमराज के दर्शन करते। तुमने छिपकर मारा। जैसे सोए हुए आदमी को, साँप डस ले।",
   "en": "\"Had you fought me face to face, today you would have met Yama. You struck from hiding, like a snake biting a sleeping man.\""
  },
  "appears_in": [
   "A35",
   "A36",
   "LF01"
  ]
 },
 "sugriva": {
  "voice_sample": "untold-ramayana/cast/voice_sugriva.mp3",
  "voice_line": {
   "reel": "A34",
   "shot": 4,
   "hi": "प्रभु, आज ही, उस बाली को मारिए, जो भाई के वेश में, मेरा शत्रु है।",
   "en": "\"My lord, today itself, kill Vali, my enemy in the form of a brother.\""
  },
  "appears_in": [
   "A34",
   "LF01"
  ]
 },
 "tara": {
  "voice_sample": "untold-ramayana/cast/voice_tara.mp3",
  "voice_line": {
   "reel": "A36",
   "shot": 5,
   "hi": "जो भाई, हारकर भागा था, वो इतनी जल्दी, फिर गरज रहा है। वो अकेला नहीं आया है।",
   "en": "\"The brother who fled in defeat is roaring again so soon. He has not come alone.\""
  },
  "appears_in": [
   "A36",
   "LF01"
  ]
 },
 "angada": {
  "voice_sample": "untold-ramayana/cast/voice_angada.mp3",
  "voice_line": {
   "reel": "LF01",
   "shot": 87,
   "hi": "पिताजी... मैं अंगद हूँ।",
   "en": "\"Father... I am Angada.\""
  },
